# SmartLogistics AI configuration
APP_NAME=SmartLogistics AI
APP_ENV=development
LOG_LEVEL=INFO

# The current Stage 3 code uses its own SQLite database path.
# This variable is a placeholder for future configuration integration.
DATABASE_URL=sqlite:///./smartlogistics.db

# Optional: reserved for a future LLM integration.
# No API key is needed for the current rule-based stages.
# LLM_API_KEY=
# LLM_MODEL=

# Generate a unique random secret of 32+ characters; never commit your real .env.
SMARTLOGISTICS_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=20
# Comma-separated exact frontend origins. Set this to your deployed HTTPS frontend URL.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
